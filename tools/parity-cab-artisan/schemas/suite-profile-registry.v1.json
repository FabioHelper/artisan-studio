{
  "schema_version": "1.0.0",
  "schema_kind": "modularization-suite/gate-profile-registry",
  "authority": {
    "suite_run_schema_owner": "parity-cab",
    "fact_writer": "transformer",
    "final_verdict_writer": "verifier",
    "readers": ["transformer", "verifier", "artifact-system"]
  },
  "publication": {
    "method": "atomic-temp-flush-rename",
    "current_pointer_advances_only_after": "schema-and-provenance-validation",
    "completed_attempts_immutable": true,
    "retry_creates_new_attempt_id": true,
    "cancelled_attempt_late_writes": "reject"
  },
  "exit_meanings": { "0": "GO", "1": "NO-GO", "2": "INCOMPLETE" },
  "profiles": {
    "library": {
      "required_gate_ids": ["01", "02", "03", "04", "05b", "09", "10", "11", "11b", "11c", "11d", "05"],
      "optional_gate_ids": ["06", "07", "08", "09b", "12", "13", "14", "15"],
      "conditional_required": [
        { "gate_ids": ["08"], "predicate": { "kind": "signal_true", "signal": "module_state_or_lifecycle" } },
        { "gate_ids": ["09b"], "predicate": { "kind": "signal_true", "signal": "jsx_or_html" } },
        { "gate_ids": ["06", "07"], "predicate": { "kind": "signal_true", "signal": "declared_side_effects" } }
      ]
    },
    "web-app": {
      "base_profile": "library",
      "required_gate_ids": ["01", "02", "03", "04", "05b", "09", "10", "11", "11b", "11c", "11d", "06", "07", "08", "09b", "05"],
      "optional_gate_ids": ["12", "13", "14", "15"],
      "conditional_required": []
    },
    "threejs": {
      "base_profile": "web-app",
      "required_gate_ids": ["01", "02", "03", "04", "05b", "09", "10", "11", "11b", "11c", "11d", "06", "07", "08", "09b", "12", "13", "14", "15", "05"],
      "optional_gate_ids": [],
      "conditional_required": []
    },
    "custom": {
      "allowed_base_profiles": ["library", "web-app", "threejs"],
      "base_profile_required": true,
      "forbid_empty_profile": true,
      "forbid_unknown_gates": true,
      "forbid_base_gate_exclusion": true,
      "require_signed_not_applicable": true
    }
  },
  "gate_catalog": {
    "01": {
      "profile_status": { "library": "required", "web-app": "required", "threejs": "required" },
      "executable": "node", "argv": ["scripts/01-inventory.cjs"],
      "prerequisites": ["bound-input-manifest"], "applicability_predicate": { "kind": "always" },
      "evidence_filename": "inventory.{side}.sij.json", "output_schema": { "kind": "parity-cab/inventory", "version": "1.0.0" },
      "accepted_decisions": ["pass"], "minimum_observations": 1, "planted_negative_fixture": "gate-01-zero-observations"
    },
    "02": {
      "profile_status": { "library": "required", "web-app": "required", "threejs": "required" },
      "executable": "node", "argv": ["scripts/02-classify.cjs"],
