      "evidence_filename": "inventory.{side}.tagged.sij.json", "output_schema": { "kind": "parity-cab/inventory-tagged", "version": "1.0.0" },
      "accepted_decisions": ["pass"], "minimum_observations": 1, "planted_negative_fixture": "gate-02-zero-observations"
    },
